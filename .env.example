# انسخ هذا الملف إلى .env وعدّل القيم عند الحاجة.
# Copy this file to .env and edit as needed.

# مزود الذكاء الاصطناعي: ollama (مجاني ومحلي) أو claude (مدفوع، يحتاج مفتاح)
AI_PROVIDER=ollama

# Ollama (مجاني) - https://ollama.com
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b

# Claude (اختياري). المفتاح يبقى في الخادم ولا يصل إلى المتصفح أبداً.
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5

# حدود الرفع بالميجابايت
MAX_UPLOAD_MB=50

# العنوان والمنفذ. اترك HOST=127.0.0.1 ليبقى التطبيق على جهازك فقط.
HOST=127.0.0.1
PORT=8000
