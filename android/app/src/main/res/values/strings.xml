    <!-- Support -->
    <string name="support_title">Help and support</string>
    <string name="faq">Common questions</string>
    <string name="faq_q1">Does my cloud phone keep running when I close the app?</string>
    <string name="faq_a1">Yes, on plans that include 24/7 running. The phone runs on our servers, not on your device.</string>
    <string name="faq_q2">Can I install any app?</string>
    <string name="faq_a2">You can install apps from the included app store or your own APK files. Google Play isn\'t preinstalled, and some apps (banking, some games) may not run in a cloud phone.</string>
    <string name="faq_q3">What happens when my subscription ends?</string>
    <string name="faq_a3">The phone stops. Its data is kept for the number of days in your plan, then deleted. Renew before then to keep it.</string>
    <string name="faq_q4">Is my data separate from other users?</string>
    <string name="faq_a4">Yes. Each cloud phone is isolated, and only your account can open or control it.</string>
