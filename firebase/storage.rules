rules_version = '2';

// Paste into Firebase console → Storage → Rules → Publish.
// Each person uploads only into their own folder; photos and videos only, up to 200 MB.
service firebase.storage {
  match /b/{bucket}/o {
    match /media/{uid}/{file} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.auth.uid == uid
        && request.resource.size < 200 * 1024 * 1024
        && (request.resource.contentType.matches('image/.*') || request.resource.contentType.matches('video/.*'));
    }
  }
}
